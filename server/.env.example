# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/zyvron

# JWT
JWT_ACCESS_SECRET=change-this-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES=7d

# SMTP (Gmail example: use a Gmail address + a Google Account App Password,
# not your normal login password - https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="Zyvron Tech Accessories <your-gmail-address@gmail.com>"

# Frontend URL (used for CORS + email links)
CLIENT_URL=http://localhost:3000

# Seeded admin account (created by `npm run seed:admin`)
ADMIN_EMAIL=admin@zyvron.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Zyvron Admin

# Cloudinary (auto-mirrors any external image URL - Google Images, etc. -
# pasted into an admin form into your own Cloudinary account, so the URL
# saved to the database is always your own stable link, not someone else's
# server. Free account: https://cloudinary.com/users/register/free -> once
# logged in, these three values are shown right on the Dashboard page.)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
